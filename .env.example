# Copy to .env and fill in. NEVER commit .env. Names only here — no real values.
# Every variable below must also be set in the Vercel project (Settings → Environment Variables).

# --- App ---
APP_URL=http://localhost:3000            # the deployed URL on Vercel
DEMO_MODE=true                           # true hides listing images (placeholder icon instead)
CRON_SECRET=                             # any long random string; supabase/cron.sql sends it as a Bearer token to /api/scan

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=                            # https://<project>.supabase.co
SUPABASE_KEY=                            # publishable / anon key (safe for the browser; read by @nuxtjs/supabase)
SUPABASE_SECRET_KEY=                     # secret / service_role key (server only)
# SUPABASE_SERVICE_KEY=                  # older name for the secret key; either one works

# --- Demo account (created by `pnpm db:seed`) ---
DEMO_EMAIL=demo@dealhound.test
DEMO_PASSWORD=                           # shown on the login page's "Use the demo account" button

# --- AI (Google AI Studio) ---
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL_SMART=gemini-flash-latest
AI_MODEL_FAST=gemini-flash-lite-latest

# --- PayPal (SANDBOX only) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=                       # optional (stretch: webhook)

# --- Channel3 ---
CHANNEL3_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=                   # without the @
TELEGRAM_WEBHOOK_SECRET=
